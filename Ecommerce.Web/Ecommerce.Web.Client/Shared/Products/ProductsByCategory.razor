@page "/productsbycategory/{CategoryId:int}"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
<style>
    button {
        background-color: black;
        color: white;
        border-radius: 5px;
        border: solid 1px;
        border-color: white;
        padding: 5px 18px;
        align-content: end;
    }

        button:hover {
            background-color: cornflowerblue;
            color: black;
        }

    .productbody {
        display: grid;
        grid-template-columns: auto auto auto auto;
        padding: 10px;
    }

    .productinner {
        display: flex; /* Make this a flex container */
        flex-direction: column; /* Stack children vertically */
        justify-content: space-between; /* Push children apart */
        background-color: rgba(255, 255, 255, 0.8);
        border: 1px solid rgba(0, 0, 0, 0.8);
        padding: 20px;
        font-size: 30px;
        text-align: center;
        border-radius: 20px;
        margin: 10px;
    }

    .prdctbuttons {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        margin-top: auto; /* Push buttons to bottom */
    }
</style>

<div class="container-fluid pt-5">
    <div class="row px-xl-5 pb-3">
        <div class="productbody">
            @if (Products is not null)
            {
                foreach (var item in Products)
                {
                    <div class="productinner">
                        <h5>@item.Product.Name</h5>
                        <p>@item.Product.Description</p>
                        <div class="prdctbuttons">
                            @if (item.Quantity is 0)
                            {
                                <button @onclick="async()=>await incrementcount(item)">Add To Cart</button>
                            }
                            else
                            {
                                <button @onclick="async()=>await incrementcount(item)">+</button>
                                <button>@item.Quantity</button>
                                <button @onclick="async()=>await decrementcount(item)">-</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>


